# Omit DATABASE_URL to use local SQLite.
# Start LM Studio's local server and load qwen/qwen3.5-9b for language edits.
ARCHAI_LM_STUDIO_URL=http://127.0.0.1:1234/v1
ARCHAI_LM_STUDIO_MODEL=qwen/qwen3.5-9b
# Optional: increase for slower devices (seconds).
# ARCHAI_LM_STUDIO_TIMEOUT=180
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
CORS_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:3000
